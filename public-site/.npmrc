# Cloudflare Pages runs `npx @cloudflare/next-on-pages@1` from this directory.
# That install now hits an unsatisfiable peer graph: next-on-pages asks for
# @cloudflare/workers-types@^4 while the wrangler@4 it pulls in asks for ^5, so
# npm aborts with ERESOLVE and the Pages build fails before it starts. Nothing
# in this repo can pick a compatible pair — both are transitive peers — so take
# npm's own suggested way out and stop resolving peers for this install.
#
# pnpm (used for the dependency install step) does not implement this setting
# and ignores it.
legacy-peer-deps=true
